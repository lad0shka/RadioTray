#include <windows.h>
#include "resource.h"
#include "version.h"

// Application icon: Explorer, the installer and the EXE file properties.
IDI_APP ICON "app.ico"

1 VERSIONINFO
FILEVERSION     RT_VERSION_CSV
PRODUCTVERSION  RT_VERSION_CSV
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "RadioTray internet radio player"
            VALUE "FileVersion",     RT_VERSION_STR
            VALUE "InternalName",    "RadioTray"
            VALUE "OriginalFilename","RadioTray.exe"
            VALUE "ProductName",     "RadioTray"
            VALUE "ProductVersion",  RT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Embedded BASS library, extracted to the per-user cache at run time.
101 RCDATA "vendor/bass/bass.dll"
